{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/check-package-manager.cjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev": "pnpm --filter @workspace/dailyflow start",
    "dev:web": "pnpm --filter @workspace/dailyflow web",
    "build:app": "pnpm --filter @workspace/dailyflow build",
    "check:app": "pnpm --filter @workspace/dailyflow typecheck",
    "test:core": "pnpm --filter @workspace/flow-core test",
    "test:dailyflow-migration": "node --test scripts/dailyflow-migration.test.cjs",
    "preview:app": "node scripts/preview.cjs"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "eas-cli": "24.7.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
