{
  "name": "@workspace/dailyflow",
  "version": "1.0.2",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node node_modules/expo/bin/cli start --dev-client",
    "web": "node node_modules/expo/bin/cli start --web",
    "android": "node node_modules/expo/bin/cli run:android",
    "build": "node node_modules/expo/bin/cli export --platform web",
    "bundle:android": "node node_modules/expo/bin/cli export --platform android",
    "typecheck": "tsc --noEmit",
    "release:check": "node ../../scripts/release-check.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "@workspace/flow-core": "workspace:*",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.0",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.0",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-image-manipulator": "~57.0.20",
    "expo-linking": "~57.0.0",
    "expo-notifications": "~57.0.0",
    "expo-secure-store": "~57.0.0",
    "expo-share-intent": "8.0.1",
    "expo-sharing": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "typescript": "~6.0.3"
  }
}
